# Public application configuration (safe for browser bundles)
NEXT_PUBLIC_APP_NAME="Plataforma Sertão Maker"
NEXT_PUBLIC_APP_ENV="development"

# Required for authentication (publishable values only; safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
APP_BASE_URL="http://localhost:3000"

# Necessária para convites administrativos do Supabase Auth. Use uma Secret Key
# moderna (ou a service_role legada), exclusivamente no servidor/Vercel.
SUPABASE_SECRET_KEY=

# Obrigatória apenas em Vercel Preview. Deve conter o ref do projeto de produção
# para impedir que previews usem acidentalmente o banco real.
# PRODUCTION_SUPABASE_PROJECT_REF="production-project-ref"

# Marco 4: mantenha false até concluir o spike e configurar o adapter real.
GOOGLE_DRIVE_UPLOAD_ENABLED="false"

# Reservado para a integração real; não preencher enquanto B-03/B-04 estiverem abertas.
# GOOGLE_PROJECT_ID=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHARED_DRIVE_ID=
# GOOGLE_ROOT_FOLDER_ID=
# CRON_SECRET=
# EMAIL_PROVIDER_API_KEY=
# Chave de API do Resend para notificações operacionais (atribuições e convites).
# EMAIL_FROM="Proodos <notificacoes@seudominio.com.br>"
# ENCRYPTION_KEY=

# Somente para o Supabase local e smoke tests; nunca configurar na Vercel.
# E2E_TEST_EMAIL="admin-a@example.invalid"
# E2E_TEST_PASSWORD="Proodos-E2E-2026!"
