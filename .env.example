# Public application configuration (safe for browser bundles)
NEXT_PUBLIC_APP_NAME="Plataforma Sertão Maker"
NEXT_PUBLIC_APP_ENV="development"

# Required for authentication (publishable values only; safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
APP_BASE_URL="http://localhost:3000"

# Marco 4: mantenha false até concluir o spike e configurar o adapter real.
GOOGLE_DRIVE_UPLOAD_ENABLED="false"

# Reservado para a integração real; não preencher enquanto B-03/B-04 estiverem abertas.
