# Public application configuration (safe for browser bundles)
NEXT_PUBLIC_APP_NAME="Plataforma Sertão Maker"
NEXT_PUBLIC_APP_ENV="development"

# Required for authentication (publishable values only; safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
APP_BASE_URL="http://localhost:3000"

# Reserved for later milestones; do not fill during Marco 2.
